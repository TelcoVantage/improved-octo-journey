    {
      "id": "c50b6226-a9ac-5226-89c1-c2f29e15dfb2",
      "name": "SenderDomain",
      "description": "Domain part of the customer's email address (computed).",
      "type": {
        "isDynamic": true,
        "isList": false,
        "name": "string"
      },
      "value": "addr = {{email.customerEmailAddress}}; ifElse(indexOf(addr, \"@\") >= 0, slice(addr, indexOf(addr, \"@\") + 1), \"\")",
      "input": false,
      "output": false
    },
    {
      "id": "5e12a582-db39-5c27-a8ab-a80eaf5445b4",
      "name": "SearchInterval",
      "description": "Analytics interval 'start/end' = DaysBack days before this email up to one hour after it arrived (computed).",
      "type": {
        "isDynamic": true,
        "isList": false,
        "name": "string"
      },
      "value": "days = number({{81b1b88d-c028-5181-b45a-cf182913c09b}}); endMs = {{scripter.rawCustomersCallStartTime}} + 3600000; startMs = endMs - days * 86400000; concat(formatDateISO(startMs), \"/\", formatDateISO(endMs))",
      "input": false,
      "output": false
    },
