    {
      "id": "16509dca-ae4b-541c-80c3-3d3743a8ee45",
      "name": "Quick reply - Acknowledge receipt",
      "action": {
        "block": [
          {
            "type": "action",
            "actionName": "scripter.copyToClipboard",
            "actionArgumentValues": [
              {
                "typeName": "interpolatedText",
                "value": "Hello,\n\nThank you for your email. We have received your request and a member of our team is looking into it. We will get back to you as soon as possible.\n\nKind regards,\n{{scripter.agentName}}"
              }
            ]
          },
          {
            "type": "action",
            "actionName": "scripter.setVariable",
            "actionArgumentValues": [
              {
                "typeName": "variableWithValue",
                "value": {
                  "variable": {
                    "typeName": "variable",
                    "value": "66f617f9-bf60-543f-a6f4-d5436f877ea1"
                  },
                  "variableTypeName": "string",
                  "valueOfVariableProperty": {
                    "typeName": "interpolatedText",
                    "value": "Quick reply 'Acknowledge receipt' copied to clipboard - paste it into your reply."
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ecc9c0b8-aede-5181-b5b6-923b715396c6",
      "name": "Quick reply - Need more information",
      "action": {
        "block": [
          {
            "type": "action",
            "actionName": "scripter.copyToClipboard",
            "actionArgumentValues": [
              {
                "typeName": "interpolatedText",
                "value": "Hello,\n\nThank you for contacting us. To help us resolve this quickly, could you please reply with:\n- Your account or reference number\n- A short description of the issue\n- Any relevant dates or screenshots\n\nKind regards,\n{{scripter.agentName}}"
              }
            ]
          },
          {
            "type": "action",
            "actionName": "scripter.setVariable",
            "actionArgumentValues": [
              {
                "typeName": "variableWithValue",
                "value": {
                  "variable": {
                    "typeName": "variable",
                    "value": "66f617f9-bf60-543f-a6f4-d5436f877ea1"
                  },
                  "variableTypeName": "string",
                  "valueOfVariableProperty": {
                    "typeName": "interpolatedText",
                    "value": "Quick reply 'Need more information' copied to clipboard - paste it into your reply."
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
